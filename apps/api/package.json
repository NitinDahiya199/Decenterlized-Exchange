{
  "name": "@dex-terminal/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -e ../../.ENV -- tsx watch src/index.ts",
    "build": "dotenv -e ../../.env -e ../../.ENV -- prisma generate && tsc -b",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "dotenv -e ../../.env -e ../../.ENV -- prisma generate && tsc -b --noEmit",
    "db:generate": "dotenv -e ../../.env -e ../../.ENV -- prisma generate",
    "db:migrate": "dotenv -e ../../.env -e ../../.ENV -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -e ../../.ENV -- prisma migrate deploy",
    "db:push": "dotenv -e ../../.env -e ../../.ENV -- prisma db push",
    "db:seed": "dotenv -e ../../.env -e ../../.ENV -- prisma db seed",
    "db:studio": "dotenv -e ../../.env -e ../../.ENV -- prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@dex-terminal/types": "workspace:*",
    "@fastify/cors": "^11.2.0",
    "@prisma/client": "^6.2.0",
    "fastify": "^5.2.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@dex-terminal/config": "workspace:*",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.17.0",
    "prisma": "^6.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
