# Copy to .env / app-specific .env.local — never commit real secrets.

# Neon Postgres (dev) — use pooled URL for serverless if needed
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Local Postgres (matches docker-compose.yml)
# DATABASE_URL="postgresql://dex:dex@localhost:5432/dex_terminal"

# Redis (cache, rate limits, Socket.IO adapter optional)
REDIS_URL="redis://localhost:6379"

# API
API_HOST="0.0.0.0"
API_PORT="4000"
API_ORIGIN="http://localhost:3000"
SESSION_SECRET="replace-with-at-least-32-random-characters"

# Next.js (apps/web)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_WS_URL="http://localhost:4000"

# Devnet RPC (no API keys in repo — inject locally)
NEXT_PUBLIC_CHAIN_ID="11155111"
NEXT_PUBLIC_RPC_URL="https://sepolia.infura.io/v3/your-key"
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""

# Hardhat / deploy (apps/contracts)
PRIVATE_KEY=""
SEPOLIA_RPC_URL=""
